
@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var currentStatus = Context.Request.Query["status"].ToString();

    var dashboardActive = currentAction == "Index";
    var complaintsActive = currentAction == "Complaints" || currentAction == "Details";

    var pendingActive = currentStatus == "Pending";
    var progressActive = currentStatus == "In Progress";
    var resolvedActive = currentStatus == "Resolved";
    var rejectedActive = currentStatus == "Rejected";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - E-Governance Admin Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Shared Citizen Portal Design -->
    <link rel="stylesheet"
          href="~/css/citizen.css"
          asp-append-version="true" />

    <!-- Admin-specific styles -->
    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
</head>

<body>

    <div class="citizen-wrapper">

        <!-- SIDEBAR -->
        <aside class="citizen-sidebar" id="adminSidebar">

            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="fa-solid fa-landmark"></i>
                </div>

                <div class="brand-text">
                    <h2>E-GOVERNANCE</h2>
                    <span>ADMIN PORTAL</span>
                </div>
            </div>

            <div class="sidebar-section-label">MAIN MENU</div>

            <nav class="sidebar-navigation">

                <!-- Dashboard -->
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="sidebar-link @(dashboardActive ? "active" : "")">

                    <i class="fa-solid fa-house"></i>
                    <span>Dashboard</span>
                </a>

                <!-- All Complaints -->
                <a asp-controller="Admin"
                   asp-action="Complaints"
                   class="sidebar-link @(complaintsActive ? "active" : "")">

                    <i class="fa-solid fa-folder-open"></i>
                    <span>All Complaints</span>
                </a>

                <!-- Complaint Status Submenu -->
                <div class="sidebar-submenu">

                    <a asp-controller="Admin"
                       asp-action="Complaints"
                       asp-route-status="Pending"
                       class="sidebar-sublink @(pendingActive ? "active" : "")">

                        <span class="submenu-dot pending-dot"></span>
                        <span>Pending</span>
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Complaints"
                       asp-route-status="In Progress"
                       class="sidebar-sublink @(progressActive ? "active" : "")">

                        <span class="submenu-dot progress-dot"></span>
                        <span>In Progress</span>
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Complaints"
                       asp-route-status="Resolved"
                       class="sidebar-sublink @(resolvedActive ? "active" : "")">

                        <span class="submenu-dot resolved-dot"></span>
                        <span>Resolved</span>
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Complaints"
                       asp-route-status="Rejected"
                       class="sidebar-sublink @(rejectedActive ? "active" : "")">

                        <span class="submenu-dot rejected-dot"></span>
                        <span>Rejected</span>
                    </a>

                </div>

            </nav>

            <!-- LOGOUT -->
            <div class="sidebar-bottom">

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="sidebar-link logout-link">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Logout</span>
                    </button>

                </form>

            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="citizen-main">

            <!-- TOP HEADER -->
            <header class="citizen-header">

                <div class="header-left">

                    <button type="button"
                            class="mobile-menu-btn"
                            id="menuToggle">

                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <div>
                        <h3>@ViewData["Title"]</h3>
                        <p>Admin Portal / @ViewData["Title"]</p>
                    </div>

                </div>

                <div class="header-right">

                    <div class="header-profile">

                        <div class="profile-avatar">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>

                        <div class="profile-details">
                            <strong>@User.Identity?.Name</strong>
                            <span>Administrator</span>
                        </div>

                    </div>

                </div>

            </header>

            <!-- PAGE CONTENT -->
            <section class="citizen-content">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()

            </section>

            <!-- FOOTER -->
            <footer class="citizen-footer">

                <p>
                    © @DateTime.Now.Year E-Governance Portal. All rights reserved.
                </p>

                <span>Serving Citizens, Building Better Communities.</span>

            </footer>

        </main>

    </div>

    <!-- MOBILE SIDEBAR OVERLAY -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- MOBILE SIDEBAR SCRIPT -->
    <script>
        const menuToggle = document.getElementById("menuToggle");
        const sidebar = document.getElementById("adminSidebar");
        const overlay = document.getElementById("sidebarOverlay");

        menuToggle?.addEventListener("click", function () {
            sidebar.classList.toggle("sidebar-open");
            overlay.classList.toggle("overlay-visible");
        });

        overlay?.addEventListener("click", function () {
            sidebar.classList.remove("sidebar-open");
            overlay.classList.remove("overlay-visible");
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
