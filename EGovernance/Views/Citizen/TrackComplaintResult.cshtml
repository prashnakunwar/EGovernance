
@model EGOVERNANCE.Models.Complaint
@using EGOVERNANCE.Models

@{
    ViewData["Title"] = "Complaint Tracking";

    var history = ViewBag.ComplaintHistory as IEnumerable<ComplaintHistory>
                  ?? Enumerable.Empty<ComplaintHistory>();
}

<div class="page-heading">
    <h1>Complaint Tracking</h1>
    <p>View your complaint details, current status and progress updates.</p>
</div>

<div class="dashboard-panel tracking-result">

    <!-- COMPLAINT HEADER -->
    <div class="tracking-header">
        <div>
            <span class="complaint-number">
                @Model.ComplaintNumber
            </span>

            <h2>@Model.Title</h2>

            <p>
                Submitted on
                @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
            </p>
        </div>

        <span class="status-badge status-@Model.Status.Replace(" ", "").ToLowerInvariant()">
            @Model.Status
        </span>
    </div>


    <!-- COMPLAINT DETAILS -->
    <div class="tracking-details">

        <div class="tracking-detail">
            <span>Category</span>
            <strong>@Model.Category</strong>
        </div>

        <div class="tracking-detail">
            <span>Location</span>
            <strong>@Model.Location</strong>
        </div>

        <div class="tracking-detail">
            <span>Ward Number</span>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.WardNumber)
                    ? "Not provided"
                    : Model.WardNumber)
            </strong>
        </div>

        <div class="tracking-detail">
            <span>Submission Date</span>
            <strong>
                @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
            </strong>
        </div>

    </div>


    <!-- COMPLAINT DESCRIPTION -->
    <div class="tracking-description">
        <h3>Complaint Description</h3>
        <p>@Model.Description</p>
    </div>


    <!-- ATTACHED IMAGE -->
    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        <div class="tracking-image">
            <h3>Attached Image</h3>

            <img src="@Model.ImagePath"
                 alt="Complaint supporting image" />
        </div>
    }


    <!-- CURRENT MUNICIPALITY REMARKS -->
    <div class="tracking-remarks">
        <h3>Latest Municipality Remarks</h3>

        @if (!string.IsNullOrWhiteSpace(Model.AdminRemarks))
        {
            <p>@Model.AdminRemarks</p>
        }
        else
        {
            <p>No remarks have been added yet.</p>
        }
    </div>


    <!-- COMPLAINT STATUS TIMELINE -->
    <div class="complaint-timeline-section">

        <div class="timeline-heading">
            <div>
                <h3>Complaint Status History</h3>
                <p>Follow the progress of your complaint.</p>
            </div>
        </div>

        @if (history.Any())
        {
            <div class="complaint-timeline">

                @foreach (var item in history)
                {
                    <div class="timeline-item">

                        <div class="timeline-marker">
                            <i class="fa-solid fa-check"></i>
                        </div>

                        <div class="timeline-content">

                            <div class="timeline-status-row">
                                <strong>@item.Status</strong>

                                <span class="status-badge status-@item.Status.Replace(" ", "").ToLowerInvariant()">
                                    @item.Status
                                </span>
                            </div>

                            <span class="timeline-date">
                                <i class="fa-regular fa-clock"></i>
                                @item.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </span>

                            @if (!string.IsNullOrWhiteSpace(item.Remarks))
                            {
                                <div class="timeline-remarks">
                                    <strong>Remarks:</strong>
                                    <p>@item.Remarks</p>
                                </div>
                            }

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fa-regular fa-clock"></i>
                <h3>No status updates available</h3>
                <p>Your complaint progress updates will appear here.</p>
            </div>
        }

    </div>


    <!-- ACTION BUTTONS -->
    <div class="tracking-actions">

        <a asp-controller="Citizen"
           asp-action="TrackComplaint"
           class="btn-cancel">
            Track Another Complaint
        </a>

        <a asp-controller="Citizen"
           asp-action="MyComplaints"
           class="btn-submit">
            My Complaints
        </a>

    </div>

</div>
